s keyword(AST):\n    arg: Optional[_identifier]\n    value: expr\n\nclass alias(AST):\n    name: _identifier\n    asname: Optional[_identifier]\n\nclass withitem(AST):\n    context_expr: expr\n    optional_vars: Optional[expr]\n"